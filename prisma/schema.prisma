generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())
  nome String
  email String @unique
  senha String
  role String @default("CUSTOMER")
  criadoEm DateTime @default(now())
  orders Order[]

  @@map("users")
}

model Product {
  id String @id @default(uuid())
  nome String
  descricao String?
  preco Float
  imagemUrl String?
  sku String @unique
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  stocks Stock[]
  orderItems OrderItem[]

  @@map("products")
}

model Stock {
  id String @id @default(uuid())
  quantidade Int @default(0)
  unidade String
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stocks")
}

model Order {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  status String @default("PENDENTE")
  total Float
  criadoEm DateTime @default(now())
  items OrderItem[]
  payment Payment?

  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantidade Int
  precoUnit Float

  @@map("order_items")
}

model Payment {
  id String @id @default(uuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status String @default("PENDENTE")
  transactionId String? @unique
  valor Float
  criadoEm DateTime @default(now())

  @@map("payments")
}

model AuditLog {
  id String @id @default(uuid())
  acao String
  entidade String
  entidadeId String?
  dados String?
  ip String?
  criadoEm DateTime @default(now())

  @@map("audit_logs")
}