{
  "info": {
    "name": "Raizes do Nordeste API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "http://localhost:3000/" }
    },
    {
      "name": "Listar Produtos",
      "request": { "method": "GET", "url": "http://localhost:3000/produtos" }
    },
    {
      "name": "Criar Produto",
      "request": {
        "method": "POST",
        "url": "http://localhost:3000/produtos",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Queijo Coalho\",\n  \"description\": \"Artesanal\",\n  \"price\": 25\n}"
        }
      }
    },
    {
      "name": "Docs Swagger",
      "request": { "method": "GET", "url": "http://localhost:3000/docs" }
    }
  ]
}